# Copy to .env and fill in. NEVER commit .env.
VAULTA_ENV=development              # development | production
AUTH_SECRET=                        # >=32 random chars (python -c "import secrets;print(secrets.token_hex(32))"). Required in production.
DATABASE_PATH=instance/vaulta.db
UPLOAD_DIR=instance/private_uploads # KYC documents. Keep OUTSIDE the web root.
PROVIDER_MODE=internal              # internal | live  (live needs provider adapters + keys; unconfigured providers refuse, they never fake success)
COOKIE_SECURE=0                     # set 1 behind HTTPS (automatic when VAULTA_ENV=production)
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Provider keys (server-side only, never sent to the browser)
PAYMENT_PROVIDER_KEY=
MARKET_DATA_API_KEY=
KYC_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
STORAGE_KEY=
# Seed overrides (development only). If unset, random passwords are generated into instance/dev-credentials.txt
ADMIN_EMAIL=admin@vaulta.test
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# ---- Crypto funding (see docs/CRYPTO.md) ----
# APP_ENV: development | staging | production   (VAULTA_ENV still works; set only one)
APP_ENV=development
# mock (development) | testnet (staging) | live (production). The app REFUSES to start with a mismatched pair.
CRYPTO_PROVIDER_MODE=mock
# Public deposit addresses, applied ONLY to a wallet that is still the NOT_CONFIGURED placeholder at first setup.
# The database is the source of truth afterwards; later changes go through the two-person approval workflow.
BTC_WALLET_ADDRESS=
ETH_WALLET_ADDRESS=
USDT_WALLET_ADDRESS=
USDC_WALLET_ADDRESS=
SOL_WALLET_ADDRESS=
# Token contracts (verify against the issuer's official list). No contract is hard-coded for staging/production.
USDT_ETHEREUM_CONTRACT=
USDC_ETHEREUM_CONTRACT=
# NEVER put private keys, seed phrases, mnemonics, signing keys or wallet passwords anywhere in this file or the environment.
# The app refuses to start if it finds variables named like that.

# ---- Trade terminal: market data (server-side only; never exposed to the browser) ----
# CoinGecko API key. Get a free Demo key at https://www.coingecko.com/en/api . Without a key the keyless public tier is used and is heavily rate-limited.
COINGECKO_API_KEY=
# demo (default, https://api.coingecko.com/api/v3, header x-cg-demo-api-key) or pro (https://pro-api.coingecko.com/api/v3, header x-cg-pro-api-key)
COINGECKO_PLAN=demo
# Optional: point at a proxy or the local mock (python tests/tools/mock_coingecko.py 5090 -> http://127.0.0.1:5090/api/v3)
COINGECKO_BASE_URL=
# Local ceiling on provider calls per minute (demo plan is ~30/min; 25 leaves headroom) and per-request timeout
MARKET_MAX_CALLS_PER_MINUTE=25
MARKET_TIMEOUT_SECONDS=8
# Hosts coin logos may be loaded from. Also used to build the Content-Security-Policy img-src. Defaults shown.
MARKET_IMAGE_HOSTS=coin-images.coingecko.com,assets.coingecko.com

# ---- Email delivery (see docs/EMAIL.md) ----
# dev (default outside production): captures mail locally, sends NOTHING.  resend | ses: real delivery (required in production).
EMAIL_PROVIDER=dev
# EMAIL_PROVIDER_KEY (above) is the Resend API key. Webhook signing secret from Resend (whsec_...): needed to confirm delivery.
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=                 # a sender on a domain you verified with the provider
EMAIL_FROM_NAME=VAULTA
EMAIL_REPLY_TO=
PUBLIC_BASE_URL=                    # https://app.example.com : the ONLY source of links in emails. Required in production.
# Outside production a real provider can only mail these (addresses or @domains). Required for staging with resend/ses.
EMAIL_SANDBOX_ALLOWLIST=
EMAIL_LINK_ALLOWED_HOSTS=
EMAIL_DEFAULT_TIMEZONE=UTC
# SES alternative:
EMAIL_SES_REGION=
EMAIL_SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Development convenience only: run.py starts the email worker thread. Production: python -m server.mailer.worker
EMAIL_INLINE_WORKER=1

# ---- Email: SMTP host (configured in Admin > Email Center > Email & SMTP; the password is stored ENCRYPTED, never in this file) ----
# EMAIL_PROVIDER=smtp makes the admin-managed SMTP settings the delivery transport. Resend/SES remain available.
# Fernet key that encrypts UI-entered secrets (the SMTP password). Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUT of the database and the repository. Several comma-separated keys allow rotation (first encrypts, all decrypt). Required for EMAIL_PROVIDER=smtp.
SETTINGS_ENCRYPTION_KEY=
# SMTP safety valves (leave unset in production). Private hosts are refused by default (SSRF guard); development may opt in for a local mail catcher.
SMTP_ALLOW_PRIVATE_HOSTS=
SMTP_EXTRA_PORTS=
SMTP_TIMEOUT_SECONDS=15
# Optional first-admin password for automation of `python -m server.bootstrap_admin` (prefer the hidden prompt).
BOOTSTRAP_ADMIN_PASSWORD=
